{
  "name": "vtuber-studio-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI VTuber 動画生成サービス — デモ画面（広告動画の収録用 / 動作確認用）",
  "scripts": {
    "build": "npm run build:studio && npm run build:embed",
    "build:studio": "esbuild src/app.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "build:embed": "esbuild src/embed.ts --bundle --format=esm --target=es2022 --outfile=public/embed.js",
    "serve": "node server.mjs",
    "dev": "npm run build && node server.mjs",
    "check": "node tools/check-presets.mjs && node tools/check.mjs && node tools/check-embed.mjs && node tools/check-lipsync.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.4",
    "ffmpeg-static": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.11",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
